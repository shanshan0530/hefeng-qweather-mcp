# 和风天气 API 配置
HEFENG_API_HOST=您的API主机地址
HEFENG_API_KEY=您的API密钥

# 远程 MCP 访问保护（云部署必填）
# 请使用至少 24 位、随机生成的长字符串；客户端通过
# Authorization: Bearer <MCP_ACCESS_TOKEN> 访问 /mcp。
MCP_ACCESS_TOKEN=请替换为随机长密钥

# 云平台通常会自动注入 PORT；本地运行可保留默认值。
HOST=0.0.0.0
PORT=8000

# 默认关闭和风的付费热带气旋工具，避免模型误调用付费 API。
# 只有确认已开通相关付费权限后再改为 true。
ENABLE_PAID_WEATHER_TOOLS=false

# 备用 JWT 认证配置（可选）
# HEFENG_PROJECT_ID=您的项目ID
# HEFENG_KEY_ID=您的凭据ID
# HEFENG_PRIVATE_KEY_PATH=./ed25519-private.pem
# HEFENG_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
